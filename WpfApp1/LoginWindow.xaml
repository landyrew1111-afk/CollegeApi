<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="520" Width="420" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" FontFamily="Segoe UI" FontSize="13" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="Электронный дневник" FontSize="17" FontWeight="SemiBold" Foreground="#212121"/>
                <TextBlock Text="колледж" FontSize="12" Foreground="#757575" VerticalAlignment="Center" Margin="10,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                Margin="24,20,24,24" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход в систему" FontSize="16" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,16"/>

                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TbLogin" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PbPass" Margin="0,0,0,8" KeyDown="PbPass_KeyDown"/>

                <TextBlock x:Name="TbError" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"
                           MinHeight="18" Margin="0,0,0,10"/>

                <Button x:Name="BtnLogin" Content="Войти" HorizontalAlignment="Left" Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
